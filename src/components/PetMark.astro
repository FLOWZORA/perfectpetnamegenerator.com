---
/**
 * Dog and cat line illustrations, drawn as inline SVG rather than raster art:
 * they inherit `currentColor` so they follow the dog/cat accent tokens in both
 * themes, cost about a kilobyte, and stay crisp at any size.
 *
 * Decorative by default - every place these appear already has a text heading
 * saying the same thing, so they are hidden from assistive tech. Pass a
 * `label` only if a mark ever stands on its own without adjacent text.
 */
export interface Props {
  pet: 'dog' | 'cat';
  /** Rendered size in pixels. */
  size?: number;
  label?: string;
  class?: string;
  /** Anything else (style, data-*) lands on the <svg>. */
  [key: string]: unknown;
}

const { pet, size = 56, label, class: className, ...rest } = Astro.props;
---

<svg
  {...rest}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {
    pet === 'dog' ? (
      <>
        {/* Floppy ears, drawn as open paths so they tuck behind the head outline. */}
        <path d="M18 19C9 16.5 4.5 25 5.5 33.5 6.5 42 12 46 18 43.5" />
        <path d="M46 19c9-2.5 13.5 6 12.5 14.5C57.5 42 52 46 46 43.5" />
        <path d="M32 9.5c8.5 0 14 5 14 12v13.5c0 10.5-6 18-14 18s-14-7.5-14-18V21.5c0-7 5.5-12 14-12Z" />
        <circle cx="26.5" cy="30" r="2.1" fill="currentColor" stroke="none" />
        <circle cx="37.5" cy="30" r="2.1" fill="currentColor" stroke="none" />
        <path
          d="M32 40c-2 0-3.4-1.2-3.4-2.5s1.5-2.1 3.4-2.1 3.4.8 3.4 2.1S34 40 32 40Z"
          fill="currentColor"
          stroke="none"
        />
        <path d="M32 40v2.6" />
        <path d="M32 42.6c0 2-1.6 3.2-3.4 3.2M32 42.6c0 2 1.6 3.2 3.4 3.2" />
      </>
    ) : (
      <>
        {/* Head and pointed ears as one continuous outline. */}
        <path d="M15.5 27 14.5 8.5 28.5 16.5c2-.4 5-.4 7 0L49.5 8.5 48.5 27c2 3.5 2 10-1 14.5C44 46.5 38 49.5 32 49.5S20 46.5 16.5 41.5c-3-4.5-3-11-1-14.5Z" />
        <circle cx="25.5" cy="31" r="2.1" fill="currentColor" stroke="none" />
        <circle cx="38.5" cy="31" r="2.1" fill="currentColor" stroke="none" />
        <path d="m32 38-2.4-2h4.8L32 38Z" fill="currentColor" stroke="none" />
        <path d="M32 38v2.2" />
        <path d="M32 40.2c0 1.7-1.4 2.8-3 2.8M32 40.2c0 1.7 1.4 2.8 3 2.8" />
        {/* Whiskers. */}
        <path d="M14.2 32.5H5M15 37.5l-8 2.6M49.8 32.5H59M49 37.5l8 2.6" />
      </>
    )
  }
</svg>
