---
import type { FaqItem } from '../lib/schema';

export interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Frequently asked questions' } = Astro.props;
---

<section aria-labelledby="faq-heading" class="mt-14">
  <h2 id="faq-heading" class="text-2xl sm:text-3xl">{heading}</h2>
  <div class="mt-5 space-y-3">
    {
      items.map((item) => (
        <details class="card px-5 py-4">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            <span class="mr-2" aria-hidden="true" style="color: var(--c-accent-on-soft);">
              ▸
            </span>
            {item.question}
          </summary>
          <p class="mt-3 pl-6 text-[0.9375rem]">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary span[aria-hidden] {
    transform: rotate(90deg);
    display: inline-block;
  }
</style>
