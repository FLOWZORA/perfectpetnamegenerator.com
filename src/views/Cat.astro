---
import BaseLayout from '../layouts/BaseLayout.astro';
import Generator from '../components/Generator.astro';
import Faq from '../components/Faq.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HeroArt from '../components/HeroArt.astro';
import SectionMark from '../components/SectionMark.astro';
import { faqSchema, breadcrumbSchema } from '../lib/schema';
import { faqItems } from '../lib/content';
import { contentVars } from '../lib/counts';
import data from '../data/pet-name-data.json';
import type { Lang } from '../i18n/config';
import { useTranslations, formatter } from '../i18n';
import { meaningIn } from '../lib/meanings';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const vars = contentVars(lang);
const f = formatter(lang, vars);
const cat = t.cat;

const byStyle = (style: string, count: number) =>
  data.cat_names
    .filter((n) => n.styles.includes(style))
    .slice(0, count)
    .map((n) => ({ ...n, meaning: meaningIn(n.meaning, lang) }));

const showcase = [
  { label: cat.showcase.elegant, names: byStyle('elegant', 6) },
  { label: cat.showcase.mythical, names: byStyle('mythical', 6) },
  { label: cat.showcase.food, names: byStyle('food', 6) },
];

const faqs = faqItems(cat.faqs, lang, vars);
---

<BaseLayout
  title={cat.title}
  description={cat.description}
  routeKey="cat"
  lang={lang}
  keywords="pet name generator cat, cat name generator, random pet name generator, pet name generator, pet name, pet name tags, cat pet names, random cat name generator, male cat names, female cat names"
  jsonLd={[
    faqSchema(faqs, lang),
    breadcrumbSchema(
      [
        { name: t.common.home, key: 'home' },
        { name: cat.breadcrumb, key: 'cat' },
      ],
      lang
    ),
  ]}
>
  <div class="wrap py-10 sm:py-14">
    <Breadcrumb lang={lang} current={cat.breadcrumb} />

    <div class="mt-4 lg:grid lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12">
      <div class="max-w-3xl">
        <p class="label mb-2" style="color: var(--c-cat); letter-spacing: 0.08em;">Pet Name Generator Cat · Random Feline Pet Names</p>
        <h1 class="text-4xl sm:text-5xl" style="color: var(--c-cat);">{cat.h1}</h1>
        <p class="answer-box mt-6">{f(cat.answerBox)}</p>
      </div>
      <HeroArt pet="cat" class="mt-8 lg:mt-0" />
    </div>

    <div class="mt-10">
      <Generator species="cat" section="cat" lang={lang} />
    </div>

    <section class="relative mt-16" aria-labelledby="sound-heading">
      <SectionMark pet="cat" />
      <div class="prose-page max-w-3xl">
        <h2 id="sound-heading">{cat.prose.heading}</h2>
        <Fragment set:html={f(cat.prose.html)} />
      </div>
    </section>

    <section class="mt-16" aria-labelledby="showcase-heading">
      <h2 id="showcase-heading" class="text-2xl sm:text-3xl">{cat.showcase.heading}</h2>
      <p class="hint mt-2 max-w-2xl">{cat.showcase.lead}</p>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {
          showcase.map((group) => (
            <article class="card p-6">
              <h3 class="text-xl">{group.label}</h3>
              <ul class="mt-3 space-y-2.5 text-[0.9375rem]">
                {group.names.map((item) => (
                  <li>
                    <strong>{item.name}</strong>
                    <span class="hint block">{item.meaning}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-16" aria-labelledby="cat-tags-heading">
      <div class="prose-page max-w-3xl">
        <h2 id="cat-tags-heading" class="text-2xl sm:text-3xl">Pet Name Tags for Cats: Lightweight Sizing & Collar Safety</h2>
        <p class="mt-4 text-[0.9375rem] leading-relaxed">
          Cat collars require tiny, lightweight <strong>pet name tags</strong> that won’t weigh down your feline’s neck or snag during climbing. Because standard cat tags are typically under 20mm in diameter, long names leave zero room for your contact phone number.
        </p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <div class="card p-5">
            <h3 class="text-lg font-semibold" style="color: var(--c-cat);">Cat Collar Tag Character Limits</h3>
            <p class="mt-2 text-[0.875rem]">
              Aim for a cat pet name between 3 and 5 letters (such as Milo, Cleo, Luna, or Kiko). Short names allow tag makers to engrave your emergency contact phone number in maximum font height.
            </p>
          </div>
          <div class="card p-5">
            <h3 class="text-lg font-semibold" style="color: var(--c-cat);">Breakaway Collar ID Advice</h3>
            <p class="mt-2 text-[0.875rem]">
              Always pair your engraved <strong>pet name tags</strong> with a quick-release breakaway collar. If the tag snags on a branch or fence, the collar safely releases while the microchip provides backup identification.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="relative mt-16" aria-labelledby="more-heading">
      <SectionMark pet="cat" />
      <div class="prose-page max-w-3xl">
        <h2 id="more-heading">{cat.more.heading}</h2>
        <Fragment set:html={f(cat.more.html)} />
      </div>
    </section>

    <Faq items={faqs} heading={cat.faqHeading} />
  </div>
</BaseLayout>
